# Copy this file to .env and fill in what you need.

PORT=4000

# The origin your Vite dev server runs on, so the browser is allowed to call this API.
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# RECOMMENDED (secure) mode: put your real AWS credentials HERE, server-side.
# If these are set, the backend ignores whatever credentials the browser sends
# and always uses these instead — your keys never have to leave your machine
# or pass through browser JavaScript at all. Uncomment and fill in to use it:
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1

# If you leave the AWS_* variables above unset, the backend falls back to
# using whatever credentials the CloudNova login screen sends with each
# request. That's fine for local, single-user testing, but it means your
# secret key does pass through the browser — see server/README.md for why
# the AWS_* env vars above are the better option for anything beyond that.
